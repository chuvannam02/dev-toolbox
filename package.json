{
	"name": "dev-toolbox",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "tauri dev",
		"dev:fe": "vite --port 1420 --strictPort",
		"build": "tauri build",
		"build:fe": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"clean:rust": "cd src-tauri && cargo clean",
		"kill:rust": "powershell -NoProfile -Command \"Get-Process cargo,rustc -ErrorAction SilentlyContinue | Stop-Process -Force\"",
		"build:safe": "set CARGO_BUILD_JOBS=1&& tauri build",
		"rebuild": "npm run kill:rust && npm run clean:rust && npm run build:safe"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@monaco-editor/react": "^4.7.0",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@tailwindcss/cli": "^4.3.3",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.3.0",
		"lucide-react": "^1.46.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-quill-new": "^3.8.3",
		"shadcn": "^4.21.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"typescript": "~5.8.3",
		"vite": "^7.0.4"
	},
	"imports": {
		"#components/*": "./src/components/*.tsx",
		"#lib/*": "./src/lib/*.ts",
		"#hooks/*": "./src/hooks/*.ts"
	}
}
